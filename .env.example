########################################
# RetailVision AI — Environment Config
########################################

# ---------- General ----------
ENVIRONMENT=development
PROJECT_NAME=RetailVision AI
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# ---------- Backend / Security ----------
SECRET_KEY=change-me-to-a-random-64-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- PostgreSQL ----------
POSTGRES_USER=retailvision
POSTGRES_PASSWORD=retailvision_dev_password
POSTGRES_DB=retailvision
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://retailvision:retailvision_dev_password@postgres:5432/retailvision

# ---------- Redis / Celery ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Storage ----------
MEDIA_ROOT=/data/media
UPLOAD_DIR=/data/media/uploads
PROCESSED_DIR=/data/media/processed
REPORT_DIR=/data/media/reports
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".avi",".mov",".mkv"]

# ---------- AI / CV pipeline ----------
YOLO_WEIGHTS_PATH=/app/ai/weights/yolov11_retail.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
BYTETRACK_TRACK_THRESH=0.5
BYTETRACK_TRACK_BUFFER=30
BYTETRACK_MATCH_THRESH=0.8
VIDEO_SWIN_WEIGHTS_PATH=/app/ai/weights/video_swin_behaviour.pth
VIDEO_SWIN_CLIP_LEN=32
VIDEO_SWIN_FRAME_STRIDE=2
FRAME_SAMPLE_FPS=5
DEVICE=cuda  # cuda | cpu

# ---------- Purchase intent model ----------
XGBOOST_MODEL_PATH=/app/ai/weights/purchase_intent_xgb.json

# ---------- LLM Business Insight Generator ----------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1500

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
